# 복사해서 사용: cp .env.example .env  (.env 는 절대 커밋하지 않습니다)

# --- MySQL (docker-compose 가 사용, 백엔드도 같은 값을 읽음) ---
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=react
MYSQL_USER=react
MYSQL_PASSWORD=change-me

# --- LLM API (AI 의견 분석·회고 보고서, 서버에서만 호출) ---
# 키는 코드·로그·응답에 남기지 않는다. 사용 이슈에서 변수를 추가한다.
LLM_API_KEY=
