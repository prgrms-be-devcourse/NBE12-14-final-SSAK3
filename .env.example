# 복사해서 사용: cp .env.example .env  (.env 는 절대 커밋하지 않습니다)

# --- MySQL (docker-compose 가 사용, 백엔드도 같은 값을 읽음) ---
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=csmatch
MYSQL_USER=csmatch
MYSQL_PASSWORD=change-me

# --- 인증 (SCRUM-89) ---
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes

# --- 외부 서비스: 사용하는 이슈에서 채움 (SCRUM-89, SCRUM-93) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- 문제 생성 LLM: Anthropic Claude API (SCRUM-93) ---
# 비워 두면 서버는 정상 기동하고, 생성 API(POST /admin/questions/generate)만 503 LLM_NOT_CONFIGURED 를 돌려준다.
LLM_API_KEY=
# 기본 모델. 생성 요청이 model 을 생략하면 이 모델을 쓴다.
LLM_MODEL=claude-sonnet-5-5
# 생성 요청이 model 로 고를 수 있는 모델(쉼표로 구분). 비워 두면 haiku-5-5, sonnet-5-5, opus-5-5.
# LLM_MODELS=claude-haiku-5-5,claude-sonnet-5-5,claude-opus-5-5
# 생성한 문제를 검증하는 모델(SCRUM-94). 비워 두면 claude-opus-5-5. 생성 모델과 다른 모델을 쓰는 편이 오류를 더 잘 잡는다.
# LLM_VERIFY_MODEL=claude-opus-5-5
