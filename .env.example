# 복사해서 사용: cp .env.example .env  (.env 는 절대 커밋하지 않습니다)

# --- MySQL (docker-compose 가 사용, 백엔드도 같은 값을 읽음) ---
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=csmatch
MYSQL_USER=csmatch
MYSQL_PASSWORD=change-me

# --- 인증 (SCRUM-89) ---
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes

# --- 외부 서비스: 사용하는 이슈에서 채움 (SCRUM-89, SCRUM-93) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
LLM_API_KEY=
