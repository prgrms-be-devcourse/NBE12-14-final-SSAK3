# 복사해서 사용: cp .env.example .env  (.env 는 절대 커밋하지 않습니다)

# --- MySQL (docker-compose 가 사용, 백엔드도 같은 값을 읽음) ---
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=react
MYSQL_USER=react
MYSQL_PASSWORD=change-me

# --- 외부 LLM API (사용 기능에서 설정) ---
LLM_API_KEY=

# --- 전체 강연 요약 (OpenAI Responses API) ---
OPENAI_API_KEY=
OPENAI_REPORT_MODEL=gpt-6-luna

# --- Gemini API (AI 의견 분석, 서버에서만 호출) ---
# 키는 코드·로그·응답에 남기지 않는다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_INPUT_USD_PER_MILLION_TOKENS=
GEMINI_OUTPUT_USD_PER_MILLION_TOKENS=

# --- 강연방 초대 링크 ---
# 운영 배포 시 실제 공개 프론트엔드 주소로 변경
ROOM_JOIN_BASE_URL=http://localhost:5173

# --- SCRUM-128 청중 익명 인증 ---
# 실제 값은 openssl rand -base64 32 로 생성한다.
# 비밀키는 같은 서버의 재시작 및 배포 사이에 유지해야 한다.
PARTICIPANT_JOIN_SECRET=
PARTICIPANT_SESSION_TTL=PT24H
