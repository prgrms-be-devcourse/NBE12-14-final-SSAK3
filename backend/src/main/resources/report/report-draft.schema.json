{
  "type": "object",
  "properties": {
    "overview": {
      "type": "object",
      "properties": {
        "mainInterests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          },
          "maxItems": 3
        },
        "reviewPoints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          },
          "maxItems": 3
        },
        "suggestions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          },
          "maxItems": 3
        }
      },
      "required": [
        "mainInterests",
        "reviewPoints",
        "suggestions"
      ],
      "additionalProperties": false
    },
    "followUp": {
      "type": "object",
      "properties": {
        "reviewedChatIds": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1
              },
              "questions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "requests": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "messageId": {
                            "type": "integer",
                            "minimum": 1
                          },
                          "quote": {
                            "type": "string",
                            "minLength": 1
                          },
                          "reexplanation": {
                            "type": "boolean"
                          }
                        },
                        "required": [
                          "messageId",
                          "quote",
                          "reexplanation"
                        ],
                        "additionalProperties": false
                      },
                      "minItems": 1
                    },
                    "answerSegmentIds": {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": 1
                      }
                    }
                  },
                  "required": [
                    "requests",
                    "answerSegmentIds"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              },
              "kind": {
                "type": "string",
                "enum": [
                  "DRAFT",
                  "PREPARATION"
                ]
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "segmentIds": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "required": [
              "title",
              "questions",
              "kind",
              "text",
              "segmentIds"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "reviewedChatIds",
        "groups"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "overview",
    "followUp"
  ],
  "additionalProperties": false,
  "$defs": {
    "item": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1
            },
            "evidence": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/evidence"
              },
              "minItems": 1
            },
            "relatedWindows": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/window"
              },
              "minItems": 1
            },
            "perspectives": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "evidence": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/evidence"
                    },
                    "minItems": 1
                  },
                  "relatedWindows": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/window"
                    },
                    "minItems": 1
                  }
                },
                "required": [
                  "text",
                  "evidence",
                  "relatedWindows"
                ],
                "additionalProperties": false
              },
              "maxItems": 0
            }
          },
          "required": [
            "text",
            "evidence",
            "relatedWindows",
            "perspectives"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "perspectives": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "evidence": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/evidence"
                    },
                    "minItems": 1
                  },
                  "relatedWindows": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/window"
                    },
                    "minItems": 1
                  }
                },
                "required": [
                  "text",
                  "evidence",
                  "relatedWindows"
                ],
                "additionalProperties": false
              },
              "minItems": 2
            },
            "text": {
              "type": "string",
              "minLength": 1
            },
            "evidence": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/evidence"
              },
              "maxItems": 0
            },
            "relatedWindows": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/window"
              },
              "maxItems": 0
            }
          },
          "required": [
            "perspectives",
            "text",
            "evidence",
            "relatedWindows"
          ],
          "additionalProperties": false
        }
      ]
    },
    "evidence": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "CHAT_MESSAGE",
                "STT_SEGMENT",
                "POLL_RESULT"
              ],
              "type": "string"
            },
            "id": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "type",
            "id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "optionIds": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              },
              "minItems": 1
            },
            "type": {
              "type": "string",
              "enum": [
                "POLL_RESULT"
              ]
            },
            "id": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "optionIds",
            "type",
            "id"
          ],
          "additionalProperties": false
        }
      ]
    },
    "window": {
      "type": "object",
      "properties": {
        "startAt": {
          "type": "string",
          "format": "date-time"
        },
        "endAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "startAt",
        "endAt"
      ],
      "additionalProperties": false
    }
  }
}
