{
  "type": "object",
  "properties": {
    "overview": {
      "type": "object",
      "properties": {
        "mainInterests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          },
          "maxItems": 3
        },
        "reviewPoints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          },
          "maxItems": 3
        },
        "suggestions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          },
          "maxItems": 3
        }
      },
      "required": [
        "mainInterests",
        "reviewPoints",
        "suggestions"
      ],
      "additionalProperties": false
    },
    "followUp": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "CANDIDATES"
            },
            "groups": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "questions": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "requests": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "messageId": {
                                "type": "integer",
                                "minimum": 1
                              },
                              "quote": {
                                "type": "string",
                                "minLength": 1
                              },
                              "reexplanation": {
                                "type": "boolean"
                              }
                            },
                            "required": [
                              "messageId",
                              "quote",
                              "reexplanation"
                            ],
                            "additionalProperties": false
                          },
                          "minItems": 1
                        }
                      },
                      "required": [
                        "requests"
                      ],
                      "additionalProperties": false
                    },
                    "minItems": 1
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "DRAFT",
                      "PREPARATION"
                    ]
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "segmentIds": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                },
                "required": [
                  "title",
                  "questions",
                  "kind",
                  "text",
                  "segmentIds"
                ],
                "additionalProperties": false
              },
              "minItems": 1
            }
          },
          "required": [
            "status",
            "groups"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "NO_QUESTIONS",
                "ALL_ANSWERED",
                "UNAVAILABLE"
              ]
            },
            "groups": {
              "type": "array",
              "items": {},
              "maxItems": 0
            }
          },
          "required": [
            "status",
            "groups"
          ],
          "additionalProperties": false
        }
      ]
    },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "startAt": {
            "type": "string",
            "format": "date-time"
          },
          "endAt": {
            "type": "string",
            "format": "date-time"
          },
          "sttSegments": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "sttGaps": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "chatMessages": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "understandingChecks": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "audienceOpinions": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "polls": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "startAt",
          "endAt",
          "sttSegments",
          "sttGaps",
          "chatMessages",
          "understandingChecks",
          "audienceOpinions",
          "polls"
        ],
        "additionalProperties": false
      }
    },
    "dataLimitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidencePolicy": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "overview",
    "followUp",
    "timeline",
    "dataLimitations",
    "evidencePolicy"
  ],
  "additionalProperties": false,
  "$defs": {
    "item": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1
            },
            "evidence": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/evidence"
              },
              "minItems": 1
            },
            "relatedWindows": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/window"
              },
              "minItems": 1
            },
            "limitations": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "perspectives": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "evidence": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/evidence"
                    },
                    "minItems": 1
                  },
                  "relatedWindows": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/window"
                    },
                    "minItems": 1
                  },
                  "limitations": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "required": [
                  "text",
                  "evidence",
                  "relatedWindows",
                  "limitations"
                ],
                "additionalProperties": false
              },
              "maxItems": 0
            }
          },
          "required": [
            "text",
            "evidence",
            "relatedWindows",
            "limitations",
            "perspectives"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1
            },
            "evidence": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/evidence"
              },
              "minItems": 1
            },
            "relatedWindows": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/window"
              },
              "minItems": 1
            },
            "limitations": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "perspectives": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "evidence": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/evidence"
                    },
                    "minItems": 1
                  },
                  "relatedWindows": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/window"
                    },
                    "minItems": 1
                  },
                  "limitations": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "required": [
                  "text",
                  "evidence",
                  "relatedWindows",
                  "limitations"
                ],
                "additionalProperties": false
              },
              "minItems": 2
            }
          },
          "required": [
            "text",
            "evidence",
            "relatedWindows",
            "limitations",
            "perspectives"
          ],
          "additionalProperties": false
        }
      ]
    },
    "evidence": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "CHAT_MESSAGE",
                "STT_SEGMENT",
                "POLL_RESULT"
              ],
              "type": "string"
            },
            "id": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "type",
            "id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "optionIds": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              },
              "minItems": 1
            },
            "type": {
              "type": "string",
              "enum": [
                "POLL_RESULT"
              ]
            },
            "id": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "optionIds",
            "type",
            "id"
          ],
          "additionalProperties": false
        }
      ]
    },
    "window": {
      "type": "object",
      "properties": {
        "startAt": {
          "type": "string",
          "format": "date-time"
        },
        "endAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "startAt",
        "endAt"
      ],
      "additionalProperties": false
    }
  }
}
