{
  "uid": "react-monitoring",
  "title": "RE:ACT Monitoring",
  "description": "SCRUM-91: RE:ACT 애플리케이션 성능 모니터링",
  "tags": ["react", "spring-boot", "monitoring"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 2,
  "editable": false,
  "refresh": "15s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 15,
      "title": "Overview - 핵심 성능 지표",
      "type": "row",
      "collapsed": false,
      "gridPos": {"x": 0, "y": 0, "w": 24, "h": 1},
      "panels": []
    },
    {
      "id": 1,
      "title": "CPU Usage",
      "description": "Spring Boot 프로세스 및 시스템 CPU 사용률",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 1, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "react-prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "process_cpu_usage{job=\"re-act-backend\"} * 100",
          "legendFormat": "Spring Boot"
        },
        {
          "refId": "B",
          "expr": "system_cpu_usage{job=\"re-act-backend\"} * 100",
          "legendFormat": "System"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "JVM Memory Usage",
      "description": "JVM Heap 및 Non-Heap 메모리 사용량",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 1, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "react-prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(jvm_memory_used_bytes{job=\"re-act-backend\",area=\"heap\"})",
          "legendFormat": "Heap"
        },
        {
          "refId": "B",
          "expr": "sum(jvm_memory_used_bytes{job=\"re-act-backend\",area=\"nonheap\"})",
          "legendFormat": "Non-Heap"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "HTTP Request Rate",
      "description": "초당 REST API 요청 수",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 9, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "react-prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"re-act-backend\",uri=~\"/api/.*\"}[$__rate_interval]))",
          "legendFormat": "Requests"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "HTTP Response Time",
      "description": "REST API 평균 및 p95, p99 응답 시간",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 9, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "react-prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "1000 * sum(rate(http_server_requests_seconds_sum{job=\"re-act-backend\",uri=~\"/api/.*\"}[$__rate_interval])) / sum(rate(http_server_requests_seconds_count{job=\"re-act-backend\",uri=~\"/api/.*\"}[$__rate_interval]))",
          "legendFormat": "Average"
        },
        {
          "refId": "B",
          "expr": "1000 * histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"re-act-backend\",uri=~\"/api/.*\"}[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "1000 * histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"re-act-backend\",uri=~\"/api/.*\"}[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "title": "HTTP Error Rate",
      "description": "REST API 전체 요청 대비 4xx 및 5xx 응답 비율",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 17, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "react-prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (sum(rate(http_server_requests_seconds_count{job=\"re-act-backend\",uri=~\"/api/.*\",status=~\"4..\"}[$__rate_interval])) or vector(0)) / sum(rate(http_server_requests_seconds_count{job=\"re-act-backend\",uri=~\"/api/.*\"}[$__rate_interval]))",
          "legendFormat": "4xx"
        },
        {
          "refId": "B",
          "expr": "100 * (sum(rate(http_server_requests_seconds_count{job=\"re-act-backend\",uri=~\"/api/.*\",status=~\"5..\"}[$__rate_interval])) or vector(0)) / sum(rate(http_server_requests_seconds_count{job=\"re-act-backend\",uri=~\"/api/.*\"}[$__rate_interval]))",
          "legendFormat": "5xx"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      }
    },
    {
