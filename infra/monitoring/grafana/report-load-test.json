      "targets": [
        {
          "refId": "A",
          "expr": "last_over_time(k6_report_completed_observed_ms_p95{run_id=~\"${run_id:regex}\",scenario=\"end_rooms\",phase=\"measured\"}[$__interval])",
          "legendFormat": "{{run_id}}",
          "interval": "1s",
