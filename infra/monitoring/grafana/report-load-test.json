      },
      "datasource": {
        "type": "prometheus",
        "uid": "react-prometheus"
      },
      "interval": "1s",
      "maxDataPoints": 1200,
      "targets": [
        {
          "refId": "A",
          "expr": "last_over_time(k6_report_rooms_measured_total{run_id=~\"${run_id:regex}\",scenario=\"end_rooms\",phase=\"measured\"}[$__interval])",
          "legendFormat": "{{run_id}}",
          "interval": "1s",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
