{
  "uid": "react-chat-load",
  "title": "RE:ACT 채팅 부하 테스트",
  "description": "채팅 일제 전송 부하 테스트용. 위 6개 숫자로 상태를 보고, 색이 변한 단계(수신, 저장, 브로드캐스트, 자원)의 그래프를 본다.",
  "tags": [
    "react",
    "load-test"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 100,
      "type": "stat",
      "title": "연결 수",
      "description": "현재 WebSocket 연결 수. 청중 수만큼 올라가야 한다.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "react-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "react_websocket_sessions_active{job=\"re-act-backend\"}"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 101,
      "type": "stat",
