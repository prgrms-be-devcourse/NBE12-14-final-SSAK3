        {
          "refId": "A",
          "expr": "100 * sum(jvm_memory_used_bytes{job=\"re-act-backend\",area=\"heap\"}) / sum(jvm_memory_max_bytes{job=\"re-act-backend\",area=\"heap\"} > 0)"
